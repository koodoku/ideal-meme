{% extends 'base.html.twig' %}

{% block title %}Deposit{% endblock %}

{% block body %}

<style>
.deposit-list {
    max-width: 600px;
    margin: 40px auto;
    background: #f8fafc;
    border-radius: 16px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.08);
    padding: 32px 24px;
    font-family: 'Segoe UI', Arial, sans-serif;
}
.deposit-item {
    background: #fff;
    border-radius: 8px;
    margin-bottom: 18px;
    padding: 18px 16px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    font-size: 1.1rem;
    color: #222;
    display: flex;
    flex-direction: column;
    gap: 4px;
}
.deposit-rate {
    color: #2563eb;
    font-weight: bold;
    font-size: 1.2rem;
}
.deposit-desc {
    color: #475569;
}
.deposit-date {
    color: #64748b;
    font-size: 0.98rem;
}
</style>

<div class="deposit-list">
    {% for deposit in deposits %}
        <div class="deposit-item">
            <span class="deposit-desc">Вклад: {{ deposit.description }}</span>
            <span class="deposit-rate">Ставка: {{ deposit.rate }}%</span>
            <span class="deposit-date">Данные за: {{ deposit.publicationMonth }}</span>
        </div>
    {% else %}
        <div>Нет данных по вкладам</div>
    {% endfor %}
</div>
{% endblock %}