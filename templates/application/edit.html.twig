{% extends 'base.html.twig' %}

{% block title %}Edit Application{% endblock %}

{% block body %}
    <div class="container" style="max-width: 500px; margin: 40px auto;">
        <h2 style="text-align:center; margin-bottom: 24px;">Редактировать заявку</h2>
        {{ form_start(form) }}
            {{ form_row(form.quantity) }}
            {{ form_row(form.price) }}
            {{ form_row(form.action) }}
            {{ form_row(form.portfolio) }}
            {{ form_row(form.stock) }}
            <div style="display: flex; gap: 12px; justify-content: center; align-items: center; margin-top: 24px;">
                <button class="btn" style="min-width: 140px;">Сохранить</button>
                <a href="{{ path('app_application_index') }}" class="btn" style="min-width: 140px;">Назад к списку</a>
                <div style="margin: 0; padding: 0;">{{ include('application/_delete_form.html.twig') }}</div>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
