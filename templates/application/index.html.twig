{% extends 'base.html.twig' %}

{% block title %}Application index{% endblock %}

{% block body %}
<div class="container">
    <h1 style="margin-bottom: 24px;">Мои заявки</h1>
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Quantity</th>
                <th>Price</th>
                <th>Action</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
        {% for application in applications %}
            <tr>
                <td>{{ application.id }}</td>
                <td>{{ application.quantity }}</td>
                <td>{{ application.price }}</td>
                <td>{{ application.action.value }}</td>
                <td>
                    <a href="{{ path('app_application_show', {'id': application.id}) }}" class="btn">Показать</a>
                    <a href="{{ path('app_application_edit', {'id': application.id}) }}" class="btn">Редактировать</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">Нет заявок</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <a href="{{ path('app_application_new') }}" class="btn">Создать новую</a>
</div>
{% endblock %}
